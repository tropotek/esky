# Host interface the port publishes on.
# 127.0.0.1 = this machine only. Set to your LAN IP to allow other machines,
# but issue profile tokens first — the server has no anonymous mode, though an
# open port is still worth avoiding until you mean it.
ESKY_BIND=127.0.0.1
ESKY_PORT=8080

# Run the containers as this host user so ./data files are owned by you and
# not by root. Find yours with `id -u` and `id -g`.
ESKY_UID=1000
ESKY_GID=1000

ESKY_EMBED_MODEL=BAAI/bge-small-en-v1.5
ESKY_RRF_K=60
ESKY_MAX_DISTANCE=0.9
